---
// Homepage (Figma: Homepage · traqqr.ai 5004:62488; mobile 5063:15558).
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageSections from '@/components/page/PageSections.astro';
import { faqItems } from '@/data/faq';
import { homePage } from '@/data/pages/home';

// Structured data for search and AI answers: who makes it, what it is, and the FAQ (from the same copy
// the page shows). No price or rating, because none is published yet.
const site = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}#organization`,
      name: 'Traqqr',
      url: site,
      logo: new URL('/logo.png', site).href,
    },
    { '@type': 'WebSite', '@id': `${site}#website`, name: 'Traqqr', url: site, publisher: { '@id': `${site}#organization` } },
    {
      '@type': 'SoftwareApplication',
      name: 'Traqqr',
      url: site,
      description: homePage.description,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      publisher: { '@id': `${site}#organization` },
      featureList: homePage.features,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout title={homePage.title} description={homePage.description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <PageSections sections={homePage.sections} />
</BaseLayout>
