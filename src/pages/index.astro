---
// Homepage (Figma: Homepage · traqqr.ai 5004:62488; mobile 5063:15558). Sections are React
// components rendered to static HTML; only the ones with behaviour are hydrated.
import { getImage } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Reveal from '@/components/Reveal.astro';
import photo from '@/assets/testimonials/dawid-przybylski.jpg';
import heroPoster from '@/assets/hero/hero-video-poster.jpg';
import scenePoster from '@/assets/scene/poster.jpg';
import { ComparisonTable, Cta, HowItWorks, Testimonial, TextMedia } from '@klicktipp/traqqr-components';
import { Hero } from '@/components/sections/Hero';
import { IntegrationsStrip } from '@/components/sections/IntegrationsStrip';
import { SunbeamScene } from '@/components/sections/SunbeamScene';
import { Faq } from '@/components/sections/Faq';
import { Globe } from '@/components/sections/Globe';
import { faqItems } from '@/data/faq';
import { integrations } from '@/data/integrations';
import { demoHref, signupHref } from '@/data/links';

// Kev's hero thumbnail, exported as 1280×720 WebP (handover §9.8), with smaller sizes for phones.
const poster = await getImage({ src: heroPoster, width: 1280, height: 720, format: 'webp', widths: [480, 640, 960, 1280] });
// First frame of the scroll video, shown until the video loads.
const sceneFrame = await getImage({ src: scenePoster, width: 1920, format: 'webp', widths: [800, 1280, 1920] });
const portrait = await getImage({ src: photo, width: 280, height: 350, format: 'webp', densities: [1, 2] });
const avatar = await getImage({ src: photo, width: 40, height: 40, format: 'webp', densities: [1, 2] });

// Copy for the library's website sections (Kev, 20 Oct).
const trial = { label: 'Start free trial', href: signupHref };
const demo = { label: 'Watch demo', href: demoHref };
const screenshot = (name: string) => ({ type: 'image' as const, placeholderLabel: `${name} screenshot coming soon` });

const title = 'Traqqr · Server-side tracking for Meta Ads';
const description =
  'Real-time tracking, attribution and insights for Meta Ads. Traqqr sends every visit, lead and sale to Meta from your server as well as the browser.';

// Structured data for search and AI answers: who makes it, what it is, and the FAQ (from the same copy
// the page shows). No price or rating, because none is published yet.
const site = new URL('/', Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${site}#organization`,
      name: 'Traqqr',
      url: site,
      logo: new URL('/logo.png', site).href,
    },
    { '@type': 'WebSite', '@id': `${site}#website`, name: 'Traqqr', url: site, publisher: { '@id': `${site}#organization` } },
    {
      '@type': 'SoftwareApplication',
      name: 'Traqqr',
      url: site,
      description,
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web',
      publisher: { '@id': `${site}#organization` },
      featureList: [
        'Server-side tracking for Meta Ads',
        'Live Feed of every event',
        'Browser and server event deduplication',
        'First-party reverse proxy on your own subdomain',
        'Event Inspector',
        `Integrations: ${integrations.map((i) => i.name).join(', ')}`,
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout title={title} description={description}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <Hero
    poster={{
      src: poster.src,
      srcSet: poster.srcSet.attribute,
      // Rendered width: 640px from xl; below that the HUD's padding (184px from lg, 72px under it).
      sizes: '(min-width: 1280px) 640px, (min-width: 1024px) calc(100vw - 184px), calc(100vw - 72px)',
    }}
  />
  <Reveal>
    <IntegrationsStrip client:visible />
  </Reveal>
  <Reveal>
    <ComparisonTable
      id="problem"
      badge="The problem"
      title="Your pixel misses sales. Traqqr doesn't."
      lead="Ad blockers, cookie banners and browser limits stop the Meta Pixel from reporting every sale. Traqqr sends the same events from your server too."
      columns={{ bad: 'Meta Pixel only', good: 'Pixel + Traqqr' }}
      rows={[
        { label: 'Ad blockers', bad: 'Events get blocked', good: 'Sent from your server' },
        { label: 'What Meta receives', bad: 'Gaps and missing sales', good: 'Every visit, lead and sale' },
        { label: 'Duplicates', bad: 'Counted twice or not at all', good: 'Deduplicated automatically' },
        { label: 'Matching people', bad: 'Weak match quality', good: 'Fingerprint helps Meta match' },
        { label: 'Setup', bad: 'Developer and tag manager', good: 'Minutes, no developer' },
      ]}
    />
  </Reveal>
  <SunbeamScene client:idle poster={{ src: sceneFrame.src, srcSet: sceneFrame.srcSet.attribute }} />
  <Reveal>
    <TextMedia
      id="product"
      badge="Live Feed"
      title="See every event the moment it happens."
      body="Watch visits, leads and sales arrive in real time, and check exactly what reached Meta from the browser and from your server."
      items={[
        'Live feed of every event',
        'Browser vs. server delivery',
        'Deduplication at a glance',
        'Fingerprint coverage per site',
        'Event Inspector for debugging',
      ]}
      primaryAction={trial}
      secondaryAction={demo}
      media={screenshot('Live Feed')}
      grid
    />
  </Reveal>
  <Reveal>
    <TextMedia
      id="reverse-proxy"
      badge="First-party reverse proxy"
      title={['Your domain. Your data.', 'Fewer blocked events.']}
      body="Route tracking through your own subdomain with Cloudflare, so ad blockers treat it like the rest of your site."
      items={[
        'Runs on your own domain',
        'Set up with Cloudflare',
        'Up to 4 proxy domains per site',
        'Falls back safely if you switch it off',
      ]}
      primaryAction={trial}
      secondaryAction={demo}
      media={screenshot('First-party reverse proxy')}
      mediaSide="left"
      grid
      borderTop
    />
  </Reveal>
  <Reveal>
    <HowItWorks
      id="how-it-works"
      badge="How it works"
      title="Live in three steps."
      lead="No tag manager, no developer. Most sites send their first server-side event within minutes."
      steps={[
        {
          eyebrow: '01 / ADD YOUR SITE',
          title: 'Paste one snippet.',
          body: "Add the Traqqr snippet to your site's <head>. That's the only code you need.",
        },
        {
          eyebrow: '02 / CONNECT',
          title: 'Link Meta and your tools.',
          body: 'Connect your Meta pixel, then tools like KlickTipp, Digistore24 or EverWebinar.',
        },
        {
          eyebrow: '03 / WATCH',
          title: 'See every event arrive.',
          body: 'Live Feed shows what reached Meta, from the browser and from your server.',
        },
      ]}
    />
  </Reveal>
  <Reveal>
    <Testimonial
      id="testimonial"
      badge="Customers"
      title="Teams that track with Traqqr"
      quote={[
        '“Since we started using traqqr.ai, our processes',
        'run far more reliably. Errors are caught early and our team',
        'always knows exactly what to do.”',
      ]}
      name="Dawid Przybylski"
      role="Founder & Managing Director, Visual Facilitators GmbH"
      photo={{ src: portrait.src, srcSet: portrait.srcSet.attribute }}
      avatar={{ src: avatar.src, srcSet: avatar.srcSet.attribute }}
    />
  </Reveal>
  <Reveal>
    <Faq client:visible />
  </Reveal>
  <Reveal>
    <Cta
      id="cta"
      title="Stop losing conversions you paid for."
      lead="Set up Traqqr in minutes and send every visit, lead and sale to Meta."
      primaryAction={trial}
      secondaryAction={demo}
    />
  </Reveal>
  <Globe client:visible />
</BaseLayout>
