---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/sections/SiteHeader.astro';
import Hero from '@/components/sections/Hero.astro';
import IntegrationsStrip from '@/components/sections/IntegrationsStrip.astro';
import ComparisonTable from '@/components/sections/ComparisonTable.astro';
import TextMedia from '@/components/sections/TextMedia.astro';
---

<BaseLayout
  title="Traqqr · Server-side tracking for Meta Ads"
  description="Real-time tracking, attribution and insights for Meta Ads. Traqqr sends every visit, lead and sale to Meta from your server as well as the browser."
>
  <SiteHeader />
  <main>
    <Hero />
    <IntegrationsStrip />
    <ComparisonTable />
    <TextMedia
      id="product"
      badge="Live Feed"
      title="See every event the moment it happens."
      body="Watch visits, leads and sales arrive in real time, and check exactly what reached Meta from the browser and from your server."
      items={[
        'Live feed of every event',
        'Browser vs. server delivery',
        'Deduplication at a glance',
        'Fingerprint coverage per site',
        'Event Inspector for debugging',
      ]}
      grid
    />
  </main>
</BaseLayout>
