---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/sections/SiteHeader.astro';
import Hero from '@/components/sections/Hero.astro';
import IntegrationsStrip from '@/components/sections/IntegrationsStrip.astro';
import ComparisonTable from '@/components/sections/ComparisonTable.astro';
import TextMedia from '@/components/sections/TextMedia.astro';
import HowItWorks from '@/components/sections/HowItWorks.astro';
import Testimonial from '@/components/sections/Testimonial.astro';
import Faq from '@/components/sections/Faq.astro';
import Cta from '@/components/sections/Cta.astro';
import SiteFooter from '@/components/sections/SiteFooter.astro';
import SunbeamScene from '@/components/motion/SunbeamScene.astro';
import Globe from '@/components/motion/Globe.astro';
---

<BaseLayout
  title="Traqqr · Server-side tracking for Meta Ads"
  description="Real-time tracking, attribution and insights for Meta Ads. Traqqr sends every visit, lead and sale to Meta from your server as well as the browser."
>
  <SiteHeader />
  <main>
    <Hero />
    <IntegrationsStrip />
    <ComparisonTable />
    <SunbeamScene />
    <TextMedia
      id="product"
      badge="Live Feed"
      title="See every event the moment it happens."
      body="Watch visits, leads and sales arrive in real time, and check exactly what reached Meta from the browser and from your server."
      items={[
        'Live feed of every event',
        'Browser vs. server delivery',
        'Deduplication at a glance',
        'Fingerprint coverage per site',
        'Event Inspector for debugging',
      ]}
      grid
    />
    <TextMedia
      id="reverse-proxy"
      badge="First-party reverse proxy"
      title={['Your domain. Your data.', 'Fewer blocked events.']}
      body="Route tracking through your own subdomain with Cloudflare, so ad blockers treat it like the rest of your site."
      items={[
        'Runs on your own domain',
        'Set up with Cloudflare',
        'Up to 4 proxy domains per site',
        'Falls back safely if you switch it off',
      ]}
      mediaSide="left"
      grid
      borderTop
    />
    <HowItWorks />
    <Testimonial />
    <Faq />
    <Cta />
    <Globe />
  </main>
  <SiteFooter />
</BaseLayout>
