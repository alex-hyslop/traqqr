---
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Link-preview image, relative to the site root. */
  image?: string;
}

const { title, description = 'Traqqr', image = '/og.png' } = Astro.props;
// Absolute URLs from `site` in astro.config.mjs, so previews and the canonical link follow the domain.
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const isPreviewHost = Astro.site?.hostname.endsWith('.vercel.app') ?? false;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0a09" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {isPreviewHost && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Traqqr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Traqqr: server-side tracking for Meta Ads" />
    <meta property="og:locale" content="en_GB" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Traqqr for AI assistants" />
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <div class="ambient" aria-hidden="true"><div class="cursor-light"></div></div>
    <slot />
    <script>
      import '@/scripts/ambient';
    </script>
  </body>
</html>
