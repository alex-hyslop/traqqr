---
import '@/styles/global.css';
import { SiteNav } from '@/components/sections/SiteNav';
import { SiteFooter } from '@/components/sections/SiteFooter';
import LanguageSuggestion from '@/components/LanguageSuggestion.astro';
import { defaultLocale, localeInfo, locales, pathFor, routes, toLocale, type Locale, type RouteKey } from '@/i18n';

/** Link-preview image. `src` is a path on this site. The size and alt must match the file. */
interface OgImage {
  src: string;
  width: number;
  height: number;
  alt: string;
}

interface Props {
  /** The page's key in src/i18n, for its canonical URL and the links to its other language. */
  route: RouteKey;
  title: string;
  description: string;
  image?: OgImage;
  /** The 404 page: never indexed, and no canonical or language links, since it has no URL of its own. */
  notFound?: boolean;
}

const defaultImage: OgImage = {
  src: '/og.png',
  width: 1200,
  height: 630,
  alt: 'Traqqr: server-side tracking for Meta Ads',
};

const { route, title, description, image = defaultImage, notFound = false } = Astro.props;
const locale = toLocale(Astro.currentLocale);
// Absolute URLs from `site` in astro.config.mjs, so previews and the canonical link follow the domain.
const canonical = new URL(pathFor(route, locale), Astro.site);
// Every language's version of this page, plus x-default (the German default) for everyone else.
const alternates = [
  ...locales.map((l) => ({ hreflang: l, href: new URL(pathFor(route, l), Astro.site) })),
  { hreflang: 'x-default', href: new URL(pathFor(route, defaultLocale), Astro.site) },
];
const imageUrl = new URL(image.src, Astro.site);
const languagePaths = Object.fromEntries(locales.map((l) => [l, pathFor(route, l)])) as Record<Locale, string>;
const isPreviewHost = Astro.site?.hostname.endsWith('.vercel.app') ?? false;
---

<!doctype html>
<html lang={locale} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0c0a09" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!notFound && <link rel="canonical" href={canonical} />}
    {!notFound && alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />)}
    {(isPreviewHost || notFound) && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Traqqr" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta property="og:locale" content={localeInfo[locale].ogLocale} />
    {locales.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={localeInfo[l].ogLocale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Traqqr for AI assistants" />
    {
      /* The homepage opens in the language the visitor chose before (src/scripts/language.ts), before
         anything paints. Only on arrival from elsewhere: a click on the logo or a nav pick stays put. */
      route === 'home' && (
        <script is:inline define:vars={{ homes: routes.home, key: 'tq-lang' }}>
          try {
            const lang = localStorage.getItem(key);
            const fromHere = document.referrer && new URL(document.referrer).origin === location.origin;
            if (lang && homes[lang] && lang !== document.documentElement.lang && !fromHere) location.replace(homes[lang]);
          } catch {}
        </script>
      )
    }
    <slot name="head" />
  </head>
  <body class="min-h-screen bg-background font-sans text-foreground antialiased">
    <div class="ambient" aria-hidden="true"><div class="cursor-light"></div></div>
    <SiteNav
      client:load
      locale={locale}
      languagePaths={languagePaths}
      currentPath={Astro.url.pathname}
    />
    <main>
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <LanguageSuggestion locale={locale} paths={languagePaths} />
    <script>
      import '@/scripts/ambient';
    </script>
  </body>
</html>
