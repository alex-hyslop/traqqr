---
// Text + media row (Figma: Block / Text + media 4689:40304, composite 4282:26715). Used by
// Live Feed (media right, grid background) and Reverse proxy (media left, border-t).
// Below lg it stacks: text first, then the media at 240px high.
import { Badge } from '@klicktipp/traqqr-components';
import { buttonVariants, cn } from '@klicktipp/traqqr-components/utils';
import { ArrowRight, Check, Image } from 'lucide-react';

interface Props {
  id?: string;
  badge: string;
  /** Pass lines to keep Figma's manual line break on desktop; it's dropped below lg (handover §3b). */
  title: string | string[];
  body: string;
  items: string[];
  mediaSide?: 'left' | 'right';
  grid?: boolean;
  borderTop?: boolean;
}

const { id, badge, title, body, items, mediaSide = 'right', grid = false, borderTop = false } = Astro.props;
const headingId = id ? `${id}-heading` : undefined;
const titleLines = Array.isArray(title) ? title : [title];
---

<section
  id={id}
  aria-labelledby={headingId}
  class:list={['relative scroll-mt-24 overflow-hidden', { 'grid-bg': grid, 'border-t': borderTop }]}
>
  <div
    class:list={[
      'relative mx-auto flex max-w-[1200px] flex-col gap-8 px-6 py-14 lg:flex-row lg:items-start lg:gap-12 lg:py-20',
      { 'lg:flex-row-reverse': mediaSide === 'left' },
    ]}
  >
    <div class="flex min-w-0 flex-1 flex-col gap-6">
      <div class="flex flex-col items-start gap-3">
        <Badge variant="outline">{badge}</Badge>
        <h2 id={headingId} class="text-3xl leading-9 font-light text-foreground lg:text-4xl lg:leading-10">
          {titleLines.map((line, i) => (i === 0 ? line : <Fragment> <br class="hidden lg:inline" />{line}</Fragment>))}
        </h2>
        <p class="text-base leading-6 text-muted-foreground">{body}</p>
      </div>

      <ul class="flex flex-col">
        {
          items.map((item) => (
            <li class="flex items-center gap-2.5 py-2 text-sm leading-5 text-card-foreground">
              <Check className="size-3.5 shrink-0" strokeWidth={1} absoluteStrokeWidth aria-hidden="true" />
              {item}
            </li>
          ))
        }
      </ul>

      <div class="flex flex-col gap-3 md:flex-row">
        <a href="/signup" class={cn(buttonVariants({ size: 'lg' }), 'w-full md:w-auto')}>
          Start free trial
          <ArrowRight strokeWidth={1.5} aria-hidden="true" />
        </a>
        <a href="#demo" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'w-full md:w-auto')}>Watch demo</a>
      </div>
    </div>

    <!-- Product screenshot slot; placeholder until the real image exists -->
    <div
      class="flex h-60 items-center justify-center rounded-xl bg-landing-placeholder lg:h-auto lg:w-[450px] lg:shrink-0 lg:self-stretch"
      role="img"
      aria-label={`${badge} screenshot coming soon`}
    >
      <Image className="size-12 text-foreground" strokeWidth={1} absoluteStrokeWidth aria-hidden="true" />
    </div>
  </div>
</section>
