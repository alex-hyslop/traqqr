---
// Testimonial (Figma: Block / Testimonials 4689:40315, homepage 5004:62530; mobile 5063:15657).
// Desktop is the Featured layout (280×350 photo + text-3xl quote); below lg the Compact one
// (text-lg quote + 40px avatar). Real legacy content: Kev needs written consent before launch.
import { Image } from 'astro:assets';
import { Badge } from '@klicktipp/traqqr-components';
import { Quote } from 'lucide-react';
import photo from '@/assets/testimonials/dawid-przybylski.jpg';

const person = {
  name: 'Dawid Przybylski',
  role: 'Founder & Managing Director, Visual Facilitators GmbH',
};
// Figma's manual line breaks on desktop; the quote wraps naturally below lg.
const quoteLines = [
  '“Since we started using traqqr.ai, our processes',
  'run far more reliably. Errors are caught early and our team',
  'always knows exactly what to do.”',
];
---

<section aria-labelledby="testimonial-heading" class="grid-bg border-y">
  <div class="mx-auto flex max-w-[1200px] flex-col items-center gap-7 px-6 py-14 lg:gap-12 lg:py-20">
    <div class="flex flex-col items-center gap-3 text-center lg:h-[84px]">
      <Badge variant="outline" className="border-transparent">Customers</Badge>
      <h2 id="testimonial-heading" class="text-3xl leading-9 font-light text-foreground lg:text-4xl lg:leading-10">
        Teams that track with Traqqr
      </h2>
    </div>

    <figure class="flex w-full gap-8 rounded-xl border bg-card p-6">
      <Image
        src={photo}
        alt={person.name}
        width={280}
        height={350}
        densities={[1, 2]}
        class="hidden h-[350px] w-[280px] shrink-0 rounded-lg object-cover lg:block"
      />
      <div class="flex min-w-0 flex-1 flex-col justify-between gap-6">
        <blockquote class="flex flex-col gap-4">
          <Quote className="hidden size-8 text-foreground lg:block" strokeWidth={1} absoluteStrokeWidth aria-hidden="true" />
          <p class="text-lg leading-7 text-muted-foreground lg:text-3xl lg:leading-9 lg:font-light">
            {quoteLines.map((line, i) => (i === 0 ? line : <Fragment> <br class="hidden lg:inline" />{line}</Fragment>))}
          </p>
        </blockquote>
        <figcaption class="flex items-center gap-3">
          <Image
            src={photo}
            alt=""
            width={40}
            height={40}
            densities={[1, 2]}
            class="size-10 shrink-0 rounded-full object-cover lg:hidden"
          />
          <div class="flex min-w-0 flex-col lg:gap-1">
            <span class="text-base leading-6 text-foreground">{person.name}</span>
            <span class="font-mono text-sm leading-5 text-muted-foreground">{person.role}</span>
          </div>
        </figcaption>
      </div>
    </figure>
  </div>
</section>
