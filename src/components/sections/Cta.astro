---
// CTA (Figma: Block / CTA 4689:40329, CTA card Background=App gradient 4784:369; mobile 5063:15673).
// The card reuses the dashboard's app background: navy → amber → navy, 44% black over it, blurred.
import { buttonVariants, cn } from '@klicktipp/traqqr-components/utils';
import { signupHref } from '@/components/nav/links';
---

<section aria-labelledby="cta-heading">
  <div class="mx-auto max-w-[1200px] px-4 py-6 md:px-6 lg:py-20">
    <div class="relative overflow-hidden rounded-xl border bg-card px-6 py-12 shadow-lg md:px-12 md:py-16">
      <div class="pointer-events-none absolute -inset-px overflow-hidden" aria-hidden="true">
        <div class="cta-glow absolute top-0 left-px h-[1294px] w-[1223px]"></div>
      </div>

      <div class="relative flex flex-col items-center gap-8 text-center">
        <div class="flex max-w-[720px] flex-col gap-4">
          <h2 id="cta-heading" class="text-3xl leading-9 font-light text-foreground lg:text-4xl lg:leading-10">
            Stop losing conversions you paid for.
          </h2>
          <p class="text-base leading-6 text-muted-foreground">
            Set up Traqqr in minutes and send every visit, lead and sale to Meta.
          </p>
        </div>
        <div class="flex flex-wrap justify-center gap-3">
          <a href={signupHref} class={buttonVariants({ size: 'lg' })}>Start free trial</a>
          <a href="#" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }))}>Watch demo</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* App background (Figma Style=Gradient 4211:139), at the CTA card's 200px blur. */
  .cta-glow {
    background:
      linear-gradient(rgb(0 0 0 / 0.44), rgb(0 0 0 / 0.44)),
      linear-gradient(224.84deg, #1c2c3e 30.35%, rgb(255 171 64 / 0.42) 41.83%, #17212c 57.17%);
    filter: blur(200px);
  }
</style>
