---
// Floating site nav. The whole header is one React island because the dropdowns, the mobile
// Sheet and the scroll state share it. Styles for the scroll state live in global.css (.site-nav).
import { SiteNav } from '@/components/nav/SiteNav';
import metaAds from '@/assets/integrations/mono/meta-ads.svg';
import facebook from '@/assets/integrations/mono/facebook.svg';
import cloudflare from '@/assets/integrations/mono/cloudflare.svg';
import klicktipp from '@/assets/integrations/mono/klicktipp.svg';
import digistore24 from '@/assets/integrations/mono/digistore24.svg';
import ablefy from '@/assets/integrations/mono/ablefy.svg';
import everwebinar from '@/assets/integrations/mono/everwebinar.svg';
import webinaris from '@/assets/integrations/mono/webinaris.svg';
import hubspot from '@/assets/integrations/mono/hubspot.svg';

const integrations = [
  { name: 'Meta Ads', logo: metaAds.src },
  { name: 'Facebook', logo: facebook.src },
  { name: 'Cloudflare', logo: cloudflare.src },
  { name: 'KlickTipp', logo: klicktipp.src },
  { name: 'Digistore24', logo: digistore24.src },
  { name: 'Ablefy', logo: ablefy.src },
  { name: 'EverWebinar', logo: everwebinar.src },
  { name: 'Webinaris', logo: webinaris.src },
  { name: 'HubSpot', logo: hubspot.src },
];
---

<SiteNav client:load integrations={integrations} />
