---
// Hero (Figma: Block / Hero HUD 4780:882, glass option on the homepage 5004:62490; mobile 4935:11570).
// The HUD's built-in header is hidden in Figma; its 64px slot stays so the floating nav sits over it.
import { buttonVariants, cn } from '@klicktipp/traqqr-components/utils';
import { ArrowRight, Play } from 'lucide-react';
import Chamfered from '@/components/shapes/Chamfered.astro';

const features = [
  { eyebrow: '01 / TRACK', title: 'Track every signal.', body: 'Every visit, lead and sale, captured server-side.' },
  { eyebrow: '02 / ATTRIBUTE', title: 'Turn data into lift.', body: 'Clean events Meta can actually use.' },
  { eyebrow: '03 / SIMPLIFY', title: 'Built for marketers.', body: 'Set up in minutes. No developer needed.' },
  { eyebrow: '04 / SCALE', title: 'A brighter pipeline.', body: 'More signal, less noise, better ROAS.' },
];
---

<section class="hero relative overflow-hidden">
  <div class="hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>

  <div class="relative mx-auto flex max-w-[1440px] flex-col gap-3 px-3 pt-[92px] lg:gap-[29px] lg:px-6 lg:pt-6 lg:pb-6">
    <Chamfered cut={32} radius={16} accent={220}>
      <div
        class="flex flex-col gap-6 px-6 pt-9 pb-6 lg:gap-14 xl:flex-row xl:items-center lg:px-[68px] lg:pt-[164px] lg:pb-20"
      >
        <div class="flex flex-col gap-6 lg:max-w-[560px] lg:gap-7 xl:w-[560px] xl:shrink">
          <h1 class="text-4xl leading-10 font-extralight text-foreground lg:text-5xl lg:leading-12">
            Real-time tracking &amp; attribution for Meta&nbsp;Ads.
          </h1>
          <p class="text-base leading-6 text-muted-foreground lg:text-lg lg:leading-7">
            Traqqr sends every visit, lead and sale to Meta from your server as well as the browser, so ad blockers and
            cookie banners stop costing you conversions.
          </p>
          <div class="flex flex-col gap-3 md:flex-row">
            <a href="#" class={cn(buttonVariants({ size: 'lg' }), 'w-full md:w-auto')}>
              Start free trial
              <ArrowRight strokeWidth={1.5} aria-hidden="true" />
            </a>
            <a href="#" class={cn(buttonVariants({ variant: 'outline', size: 'lg' }), 'w-full md:w-auto')}>
              <Play strokeWidth={1.5} aria-hidden="true" />
              Watch demo · 2 min
            </a>
          </div>
        </div>

        <div id="demo" class="min-w-0 xl:flex-[1_1_45%]">
          <div
            class="flex aspect-video items-center justify-center overflow-hidden rounded-xl border bg-landing-placeholder shadow-lg"
          >
            <button
              type="button"
              aria-label="Play the 2-minute demo"
              class={cn(buttonVariants({ variant: 'primary', size: 'icon-lg' }), 'rounded-full')}
            >
              <Play strokeWidth={1.5} aria-hidden="true" />
            </button>
          </div>
        </div>
      </div>
    </Chamfered>

    <ul class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-4 lg:gap-4">
      {
        features.map((feature) => (
          <Chamfered as="li" class="flex flex-col gap-2 p-6">
            <p class="pb-2 font-mono text-xs leading-4 text-muted-foreground">{feature.eyebrow}</p>
            <h2 class="text-lg leading-7 font-normal text-card-foreground">{feature.title}</h2>
            <p class="text-sm leading-5 text-muted-foreground">{feature.body}</p>
          </Chamfered>
        ))
      }
    </ul>
  </div>
</section>

<style>
  /* Top glow: half radial brand glow from the top edge, behind the HUD and cards. */
  .hero-glow {
    background: radial-gradient(
      847px 846px at 50% 0,
      var(--hero-glow-core) 0%,
      var(--hero-glow-mid) 50%,
      rgb(255 153 51 / 0) 100%
    );
  }
</style>
