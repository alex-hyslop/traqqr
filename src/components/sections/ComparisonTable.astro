---
// Problem · comparison table (Figma: Block / Comparison table 4689:40361 with the HUD frame on,
// homepage 5004:62515; mobile stacked rows 5063:15604). Same data drives both layouts:
// a table from lg up, stacked rows below.
import {
  Badge,
  Table,
  TableBody,
  TableCell,
  TableHead,
  TableHeader,
  TableRow,
} from '@klicktipp/traqqr-components';
import Chamfered from '@/components/shapes/Chamfered.astro';

const columns = { pixel: 'Meta Pixel only', traqqr: 'Pixel + Traqqr' };

const rows = [
  { label: 'Ad blockers', pixel: 'Events get blocked', traqqr: 'Sent from your server' },
  { label: 'What Meta receives', pixel: 'Gaps and missing sales', traqqr: 'Every visit, lead and sale' },
  { label: 'Duplicates', pixel: 'Counted twice or not at all', traqqr: 'Deduplicated automatically' },
  { label: 'Matching people', pixel: 'Weak match quality', traqqr: 'Fingerprint helps Meta match' },
  { label: 'Setup', pixel: 'Developer and tag manager', traqqr: 'Minutes, no developer' },
];

const pixelCell = 'rounded-lg bg-destructive-subtle text-center text-sm leading-5 text-foreground';
const traqqrCell = 'rounded-lg bg-success-subtle text-center text-sm leading-5 text-foreground';
---

<section id="problem" aria-labelledby="problem-heading" class="relative mx-auto max-w-[1440px] scroll-mt-24">
  <Chamfered
    cut={32}
    radius={16}
    accent={220}
    fill="none"
    class="pointer-events-none absolute inset-x-3 inset-y-6 md:inset-x-6"
    aria-hidden="true"
  />

  <div class="relative mx-auto flex w-full max-w-[1248px] flex-col items-center gap-7 px-9 py-14 md:px-12 lg:gap-12 lg:py-20">
    <div class="flex max-w-[680px] flex-col items-center gap-3 text-center">
      <Badge variant="outline">The problem</Badge>
      <h2 id="problem-heading" class="text-3xl leading-9 font-light text-foreground lg:text-4xl lg:leading-10">
        Your pixel misses sales. Traqqr doesn't.
      </h2>
      <p class="text-base leading-6 text-muted-foreground">
        Ad blockers, cookie banners and browser limits stop the Meta Pixel from reporting every sale. Traqqr sends the
        same events from your server too.
      </p>
    </div>

    <div class="w-full rounded-xl border bg-card p-3 lg:p-4">
      <!-- lg and up: the table -->
      <Table className="hidden table-fixed border-separate border-spacing-2 lg:table">
        <TableHeader className="[&_tr]:border-0">
          <TableRow className="border-0">
            <TableHead className="w-[320px]"><span class="sr-only">Topic</span></TableHead>
            <TableHead className="text-center font-normal text-destructive">{columns.pixel}</TableHead>
            <TableHead className="text-center font-normal text-success">{columns.traqqr}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {
            rows.map((row) => (
              <TableRow className="border-0">
                <TableHead scope="row" className="h-auto p-2 font-sans text-sm leading-5 font-normal text-foreground">
                  {row.label}
                </TableHead>
                <TableCell className={`${pixelCell} px-4 py-3`}>{row.pixel}</TableCell>
                <TableCell className={`${traqqrCell} px-4 py-3`}>{row.traqqr}</TableCell>
              </TableRow>
            ))
          }
        </TableBody>
      </Table>

      <!-- Below lg: stacked rows, the two cells side by side under each label -->
      <div class="flex flex-col gap-4 lg:hidden">
        <div class="grid grid-cols-2 gap-2 font-mono text-sm leading-5" aria-hidden="true">
          <p class="text-center whitespace-nowrap text-destructive">{columns.pixel}</p>
          <p class="text-center whitespace-nowrap text-success">{columns.traqqr}</p>
        </div>
        <dl class="flex flex-col gap-4">
          {
            rows.map((row) => (
              <div class="flex flex-col gap-1.5">
                <dt class="text-sm leading-5 text-foreground">{row.label}</dt>
                <dd class="grid grid-cols-2 items-stretch gap-2">
                  <p class={`${pixelCell} flex min-h-15 items-center justify-center p-2.5`}>
                    <span class="sr-only">{columns.pixel}: </span>
                    {row.pixel}
                  </p>
                  <p class={`${traqqrCell} flex min-h-15 items-center justify-center p-2.5`}>
                    <span class="sr-only">{columns.traqqr}: </span>
                    {row.traqqr}
                  </p>
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
