---
// Integrations strip (Figma: Block / Integrations strip 5058:1639; mobile 5063:15579).
// Logos exported from Figma; Meta Ads is a 2x PNG because its symbol is a raster gradient.
import { IntegrationTiles } from '@/components/IntegrationTiles';
import metaAds from '@/assets/integrations/meta-ads.png';
import facebook from '@/assets/integrations/facebook.svg';
import cloudflare from '@/assets/integrations/cloudflare.svg';
import klicktipp from '@/assets/integrations/klicktipp.svg';
import digistore24 from '@/assets/integrations/digistore24.svg';
import ablefy from '@/assets/integrations/ablefy.svg';
import everwebinar from '@/assets/integrations/everwebinar.svg';
import webinaris from '@/assets/integrations/webinaris.svg';
import hubspot from '@/assets/integrations/hubspot.svg';

const integrations = [
  { name: 'Meta Ads', logo: metaAds.src },
  { name: 'Facebook', logo: facebook.src },
  { name: 'Cloudflare', logo: cloudflare.src },
  { name: 'KlickTipp', logo: klicktipp.src },
  { name: 'Digistore24', logo: digistore24.src },
  { name: 'Ablefy', logo: ablefy.src },
  { name: 'EverWebinar', logo: everwebinar.src },
  { name: 'Webinaris', logo: webinaris.src },
  { name: 'HubSpot', logo: hubspot.src },
];
---

<section id="integrations" aria-labelledby="integrations-heading" class="scroll-mt-24">
  <div
    class="mx-auto flex max-w-[1200px] flex-col gap-5 px-6 pt-12 pb-6 md:pb-12 lg:flex-row lg:items-center lg:gap-10 xl:gap-15"
  >
    <div class="flex shrink-0 flex-col gap-1.5">
      <h2 id="integrations-heading" class="text-2xl leading-8 font-light text-foreground">Integrations</h2>
      <p class="text-base leading-6 text-muted-foreground">Works with the tools you already use.</p>
    </div>
    <IntegrationTiles client:visible integrations={integrations} />
  </div>
</section>

<style is:global>
  .logo-tile {
    background-image: linear-gradient(-57.65deg, var(--card-media-from) 20.1%, var(--card-media-to) 85.78%);
  }
</style>
