---
// The one chamfered shape for the site (Figma: Card / Landing chamfered, HUD / Frame/Glass).
// Styles live in global.css under .chamfer; content goes in the slot and sits above the glass.
import type { HTMLAttributes, HTMLTag } from 'astro/types';

interface Props extends Omit<HTMLAttributes<'div'>, 'style'> {
  as?: HTMLTag;
  /** Size of the 45° cut in px: 24 for cards, 32 for the hero HUD. */
  cut?: number;
  /** Radius of the two uncut corners in px: 12 for cards, 16 for the hero HUD. */
  radius?: number;
  /** Length of the straight part of the accent lines in px, or 0 for none. */
  accent?: number;
  /** 'glass' for cards and the hero; 'none' for the outline-only HUD frame around a section. */
  fill?: 'glass' | 'none';
  class?: string;
}

const { as: Tag = 'div', cut = 24, radius = 12, accent = 96, fill = 'glass', class: className, ...rest } = Astro.props;
const style = `--chamfer-cut:${cut}px;--chamfer-radius:${radius}px;--chamfer-accent:${accent}px`;
---

<Tag {...rest} class:list={['chamfer', className]} style={style} data-fill={fill}>
  <span class="chamfer-surface" aria-hidden="true"></span>
  <span class="chamfer-edge" data-corner="tr" aria-hidden="true"></span>
  <span class="chamfer-edge" data-corner="bl" aria-hidden="true"></span>
  {
    accent > 0 && (
      <>
        <span class="chamfer-accent" data-corner="tr" aria-hidden="true" />
        <span class="chamfer-accent" data-corner="bl" aria-hidden="true" />
      </>
    )
  }
  <slot />
</Tag>
