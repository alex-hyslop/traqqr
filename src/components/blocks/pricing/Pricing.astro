---
// Figma: "Pricing 02" node 6288:5083
import { Check, Flame } from "lucide-react";
import { cn } from "@/lib/utils";
import { buttonVariants } from "@/components/ui/button";

interface Tier {
  name: string;
  description: string;
  price: string;
  featured?: boolean;
  features: string[];
}

const tiers: Tier[] = [
  {
    name: "Free",
    description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.",
    price: "€0",
    features: [
      "Access to all core Shadcn UI blocks",
      "Copy-paste ready React Tailwind code",
      "Regular library updates",
      "Commercial use license",
      "Community support & documentation",
    ],
  },
  {
    name: "Pro",
    description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.",
    price: "€1100",
    featured: true,
    features: [
      "Everything in Pro",
      "Premium templates & more sections",
      "Early access to new components",
      "Private Discord & priority support",
      "Monthly strategy & growth sessions",
    ],
  },
  {
    name: "Custom Enterprise",
    description: "Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod.",
    price: "",
    features: [
      "Everything in Pro Plus",
      "Unlimited team seats",
      "Dedicated UI & integration support",
      "Custom component requests",
      "One-on-one implementation",
    ],
  },
];
---

<section id="pricing" class="w-full px-4 py-16 md:px-20 md:py-20">
  <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-8 md:gap-12 md:px-16">
    <h2 class="max-w-[772px] text-center font-heading text-3xl font-medium tracking-tight text-foreground md:text-5xl">
      Pick the plan that fits you
    </h2>

    <div class="grid w-full grid-cols-1 gap-6 lg:grid-cols-3">
      {
        tiers.map((tier) => (
          <div
            class={cn(
              "flex flex-col gap-8 rounded-xl border bg-background p-8",
              tier.featured
                ? "border-[3px] border-primary shadow-lg"
                : "border-border"
            )}
          >
            <div class="flex flex-col gap-8">
              <div class="flex flex-col gap-3">
                <div class="flex items-start gap-4">
                  <p class="flex-1 font-heading text-2xl font-medium tracking-tight text-foreground">
                    {tier.name}
                  </p>
                  {tier.featured && (
                    <span class="flex shrink-0 items-center gap-1.5 rounded-full bg-primary px-3 py-1 text-sm text-primary-foreground">
                      <Flame size={16} />
                      Most Popular
                    </span>
                  )}
                </div>
                <p class="text-sm leading-6 text-muted-foreground">{tier.description}</p>
              </div>

              {tier.price && (
                <div class="flex items-end gap-2">
                  <p class="font-heading text-5xl font-medium tracking-tight text-foreground">
                    {tier.price}
                  </p>
                  <p class="pb-1 text-base text-muted-foreground">/month</p>
                </div>
              )}
            </div>

            <hr class="border-border" />

            <ul class="flex flex-col gap-4">
              {tier.features.map((feature) => (
                <li class="flex items-center gap-3">
                  <Check size={16} className="shrink-0 text-primary" />
                  <span class="text-sm text-muted-foreground">{feature}</span>
                </li>
              ))}
            </ul>

            <a
              href="#"
              class={cn(
                buttonVariants({ variant: tier.featured ? "default" : "outline", size: "lg" }),
                "h-12 w-full"
              )}
            >
              Get started
            </a>
          </div>
        ))
      }
    </div>
  </div>
</section>
