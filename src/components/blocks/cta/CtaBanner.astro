---
// Figma: "CTA 01" node 6288:5041
import { ChevronRight } from "lucide-react";
---

<section class="w-full px-7 py-12 md:px-20 md:py-20">
  <div class="mx-auto w-full max-w-[1280px] 2xl:px-16">
    <div class="relative isolate flex flex-col items-center gap-10 overflow-hidden rounded-xl border border-border bg-card px-6 py-16 text-center md:gap-13 md:p-[120px]">
      <div
        class="pointer-events-none absolute -bottom-1 -left-1 -z-10 h-[280px] w-[90%] opacity-80 blur-[100px] md:h-[322px] md:blur-[150px]"
        style="background: radial-gradient(circle at 20% 30%, #ffab40 0%, rgba(56,189,248,0.1) 65%, transparent 85%);"
        aria-hidden="true"
      />

      <div class="flex flex-col items-center gap-6">
        <h2 class="font-heading text-3xl font-medium leading-tight tracking-tight text-card-foreground md:text-5xl md:leading-[48px] md:tracking-[-1px]">
          Your data is leaking.<br />You just don&rsquo;t know it yet.
        </h2>
        <p class="max-w-[804px] text-base leading-6 text-muted-foreground">
          Traqqr audits the entire stack continuously&mdash;bridging browser drop-offs with
          deterministic server reconciliation so your ad platform algorithms actually learn on
          pure truth.
        </p>
      </div>

      <a
        href="/signup"
        class="flex h-12 items-center gap-4 rounded-full bg-primary py-1 pl-5 pr-1 text-sm font-medium text-primary-foreground"
      >
        Get Started Today
        <span class="flex size-9 items-center justify-center rounded-full bg-background text-foreground">
          <ChevronRight size={16} />
        </span>
      </a>
    </div>
  </div>
</section>
