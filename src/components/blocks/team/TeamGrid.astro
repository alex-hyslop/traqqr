---
// Figma: "Teams 02" node 6288:5367 — the design shows each member's default
// and hover state as separate mocked-up columns; here that's one card per
// member with a CSS-only hover treatment (amber duotone + pointer cue).
import { Image } from "astro:assets";
import { MousePointer } from "lucide-react";
import mario from "@/assets/images/people/mario-wolosz.jpg";
import kathrin from "@/assets/images/people/kathrin-reiss.jpg";

const team = [
  { photo: mario, name: "Mario Wolosz", role: "Founder" },
  { photo: kathrin, name: "Kathrin Reiß", role: "Marketing Strategist" },
];
---

<section class="w-full px-4 py-16 md:px-20 md:py-20">
  <div class="mx-auto flex w-full max-w-[1280px] flex-col items-center gap-10 md:gap-16 md:px-16">
    <div class="flex flex-col items-center gap-3 text-center">
      <h2 class="font-heading text-3xl font-semibold tracking-tight text-foreground md:text-5xl">
        The core team
      </h2>
      <p class="text-base text-muted-foreground">
        Our team is committed to redefining tracking solutions
      </p>
    </div>

    <div class="grid w-full max-w-[600px] grid-cols-2 gap-6 md:gap-8">
      {
        team.map(({ photo, name, role }) => (
          <div class="flex flex-col gap-4">
            <div class="group relative h-[220px] overflow-hidden rounded-xl sm:h-[280px] md:h-[324px]">
              <Image
                src={photo}
                alt={name}
                class="size-full object-cover transition-[filter] duration-300 group-hover:brightness-90 group-hover:sepia group-hover:saturate-200 group-hover:hue-rotate-[-10deg]"
              />
              <div
                class="absolute inset-0 bg-primary opacity-0 mix-blend-color transition-opacity duration-300 group-hover:opacity-70"
                aria-hidden="true"
              />
              <div class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-300 group-hover:opacity-100">
                <MousePointer size={22} className="text-background" fill="black" />
              </div>
            </div>
            <div class="flex flex-col gap-1">
              <p class="text-xl font-medium text-foreground">{name}</p>
              <p class="text-base text-muted-foreground">{role}</p>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
