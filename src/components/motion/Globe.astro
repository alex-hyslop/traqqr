---
/* Globe section above the footer (homepage). Ported from the prototype "Traqqr Homepage Motion".
   Example data only: the 5 readouts and the live events in scripts/motion/globe.js are made up.
   Below 980px only 3 readouts show (.minor hidden). Reduced motion: everything shows, nothing moves. */
---
  <section class="globe-sec" id="globe" data-globe aria-label="Example events arriving from around Europe">
    <div class="dome" aria-hidden="true"></div>
    <canvas aria-hidden="true"></canvas>
    <div class="sig right" data-city="Berlin" data-top="90"><i class="stem"></i><i class="tick"></i><div class="ro"><span class="k">DE · BERLIN</span><b>Purchase · €49.00</b><span class="s">Digistore24 · server<em aria-label="confirmed"><svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></em></span></div></div>
    <div class="sig left minor" data-city="London" data-top="150"><i class="stem"></i><i class="tick"></i><div class="ro"><span class="k">UK · LONDON</span><b>Lead</b><span class="s">Deduplicated<em aria-label="confirmed"><svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></em></span></div></div>
    <div class="sig left" data-city="Madrid" data-top="250"><i class="stem"></i><i class="tick"></i><div class="ro"><span class="k">ES · MADRID</span><b>Purchase · €129.00</b><span class="s">Ablefy · server<em aria-label="confirmed"><svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></em></span></div></div>
    <div class="sig right" data-city="Istanbul" data-top="240"><i class="stem"></i><i class="tick"></i><div class="ro"><span class="k">TR · ISTANBUL</span><b>Registration</b><span class="s">EverWebinar<em aria-label="confirmed"><svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></em></span></div></div>
    <div class="sig left minor" data-city="Dubai" data-top="380"><i class="stem"></i><i class="tick"></i><div class="ro"><span class="k">AE · DUBAI</span><b>PageView</b><span class="s">Reverse proxy<em aria-label="confirmed"><svg class="ok" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></em></span></div></div>
  </section>

<style is:global>
.globe-sec{position:relative;z-index:1;width:100%;aspect-ratio:1600/860;max-height:900px;min-height:420px;overflow:hidden;margin-top:24px}
.globe-sec .dome{position:absolute;border-radius:50%;background:#141210;pointer-events:none}
.globe-sec canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.sig{position:absolute;left:0;top:0;z-index:2;pointer-events:none;will-change:transform}
.sig .stem{position:absolute;left:0;top:0;width:1px;background:linear-gradient(to bottom,rgba(255,255,255,.9),rgba(255,255,255,.12));transform-origin:50% 100%;transform:scaleY(0);transition:transform .8s cubic-bezier(.2,.7,.2,1)}
.sig .tick{position:absolute;left:-2px;top:-2px;width:5px;height:5px;border-radius:50%;background:#fff;opacity:0;transition:opacity .3s .55s}
.sig .ro{position:absolute;top:-4px;display:grid;gap:4px;padding:10px 12px;border:1px solid rgba(255,255,255,.14);border-radius:4px;background:rgba(12,10,9,.72);
  -webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px);white-space:nowrap;opacity:0;transform:translateY(12px);transition:opacity .5s .5s, transform .6s .5s cubic-bezier(.2,.7,.2,1), border-color .6s;transform-origin:left top}
.sig .ro{scale:var(--sc,1)}
.sig.right .ro{left:10px;transform-origin:left top}
.sig.left .ro{right:10px;transform-origin:right top}
.sig .k{font:400 11px/1.3 var(--font-mono, "Space Mono", ui-monospace, monospace);color:rgba(255,255,255,.55);letter-spacing:.04em}
.sig b{font:400 13px/1.3 var(--font-mono, "Space Mono", ui-monospace, monospace);color:var(--foreground, #fafaf9)}
.sig .s{font:400 11px/1.3 var(--font-mono, "Space Mono", ui-monospace, monospace);color:rgba(255,255,255,.55)}
.sig .s em{font-style:normal;color:var(--success, #4ade80);margin-left:6px}
.ok{display:inline-block;width:1.1em;height:1.1em;vertical-align:-.2em}
.sig.on .stem{transform:scaleY(1)}
.sig.on .tick{opacity:1}
.sig.on .ro{opacity:1;transform:none}
.sig.ping .ro{border-color:rgba(255,183,77,.75)}
.sig.swap .ro b,.sig.swap .ro .s{animation:swapin .5s ease}
@keyframes swapin{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.globe-sec .ok{display:inline-block;width:1.1em;height:1.1em;vertical-align:-.2em}
@media (max-width: 980px){ .sig.minor{display:none} }
</style>

<script>
  import { initGlobe } from '../../scripts/motion/globe.js';
  document.querySelectorAll('[data-globe]').forEach((el) => initGlobe(el));
</script>
