---
/* Sunbeam scene: the coffee-shop video scrubs with scroll, and Julian's tracker card (GSAP) follows the
   video time. Ported from the prototype. Needs: npm i gsap, the 5 files in /public/media, Space Mono.
   Mobile (< 760px): the card sits in a band above the video; the stem rises from the lid into the card. */
---
  <section class="scene-band" id="scene" aria-label="Example: a purchase tracked live">
    <div class="scene-track">
      <div class="scene-pin">
        <div class="scene">
          <img class="media" src="/media/poster.jpg" alt="" aria-hidden="true">
          <video class="media" muted playsinline preload="auto" disablepictureinpicture disableRemotePlayback aria-hidden="true" tabindex="-1">
            <source src="/media/scrub-720.mp4" type="video/mp4" media="(max-width: 768px)">
            <source src="/media/scrub-720.webm" type="video/webm" media="(max-width: 768px)">
            <source src="/media/scrub-1080.mp4" type="video/mp4">
            <source src="/media/scrub-1080.webm" type="video/webm">
          </video>
          <div class="topfade" aria-hidden="true"></div>
          <div class="hint" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="m19 12-7 7-7-7"/></svg><span>Scroll to play</span></div>
          <div class="scrub-bar" aria-hidden="true"><i></i></div>
        </div>
        <p class="scene-cap">Example data · the card is live HTML over the video</p>
      </div>
    </div>
  </section>

<style is:global>
.scene-band{position:relative;padding:48px 16px}
@media (min-width:700px){.scene-band{padding-inline:48px}}
/* The track is taller than the viewport; the scene pins while you scroll through it. */
.scene-track{position:relative;max-width:1600px;margin:0 auto;height:calc(var(--scene-h,56vw) + var(--scrub,150vh))}
.scene-pin{position:sticky;top:var(--pin-top,80px)}
.scene{position:relative;isolation:isolate;overflow:hidden;border-radius:16px;background:#1b140d;aspect-ratio:16/9}
.scene .media{position:absolute;left:0;right:0;top:0;width:100%;height:100%;object-fit:cover}
.scene .topfade{display:none}
/* Overlay by Julian (19 Oct): one GSAP timeline in video seconds. */
/* Sunbeam overlay (Traqqr): the signal readout over the laptop video. Pairs with sunbeam-overlay.js.
   Positions and motion come from the script; this file is only looks. Values = Traqqr Motion Kit tokens. */
.sbo { position: absolute; inset: 0; pointer-events: none; font-family: var(--font-mono, "Space Mono", ui-monospace, monospace); color: #fafaf9; }
.sbo i { display: block; }

/* the two ends of the line are the same small point: the source on the lid and the tick at the card */
.sbo-dot { position: absolute; width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px; border-radius: 50%; background: #fff;
  box-shadow: 0 0 6px rgba(255, 214, 150, .55); }
/* the stem: 1 px line of light, brightest at the top, drawn upward from the source */
.sbo-stem { position: absolute; width: 1px; margin-left: -.5px; transform-origin: 50% 100%;
  background: linear-gradient(to bottom, rgba(255,255,255,.9), rgba(255,255,255,.12)); }

/* the readout card (kit spec: 13 px = 1, scaled with font-size by the script) */
.sbo-card { position: absolute; left: 0; top: 0; font-size: 13px; }
.sbo-ro { position: relative; display: grid; gap: .31em; padding: .77em .92em; white-space: nowrap;
  background: rgba(12,10,9,.72); border: 1px solid rgba(255,255,255,.14); border-radius: .31em;
  -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px); box-shadow: 0 .6em 1.6em -.4em rgba(0,0,0,.45); }
.sbo-k { font-size: .846em; line-height: 1.3; letter-spacing: .04em; color: rgba(255,255,255,.55); }
/* each line is a one-line window; events roll through it */
.sbo-win { position: relative; overflow: hidden; line-height: 1.3; height: 1.3em; }
.sbo-win.s { font-size: .846em; color: rgba(255,255,255,.55); }
.sbo-row { position: absolute; left: 0; top: 0; white-space: nowrap; font-weight: 400; }
.sbo-ok { display: inline-block; width: 1.1em; height: 1.1em; vertical-align: -.2em; margin-left: .5em; color: #4ade80; }
.sbo-ok svg { display: block; width: 100%; height: 100%; }
/* the kit's ping (amber edge on a new event), and the warm rim that follows the sunlight in the footage */
.sbo-ping { position: absolute; inset: -1px; border-radius: inherit; border: 1px solid rgba(255,183,77,.75); opacity: 0; }
.sbo-rim { position: absolute; inset: -1px; border-radius: inherit; padding: 1px; opacity: 0;
  background: linear-gradient(135deg, rgba(255,206,140,1) 0%, rgba(255,206,140,.25) 35%, transparent 60%);
  -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
  mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0); }
.sbo-stem, .sbo-dot, .sbo-ro, .sbo-row { will-change: transform, opacity; }

.scene .hint{position:absolute;left:16px;bottom:16px;display:flex;align-items:center;gap:8px;padding:6px 10px;border-radius:6px;background:rgba(0,0,0,.35);
  -webkit-backdrop-filter:blur(8px);backdrop-filter:blur(8px);font:400 11px/1 var(--font-mono, "Space Mono", ui-monospace, monospace);letter-spacing:.04em;color:rgba(255,255,255,.8);pointer-events:none;transition:opacity .4s,transform .4s}
.scene .hint i{width:6px;height:6px;border-radius:50%;background:var(--brand, #ffb74d)}
.scene .hint svg{width:12px;height:12px}
.scene.played .hint,.scene.static .hint{opacity:0;transform:translateY(4px)}
/* Thin progress bar along the bottom edge while scrubbing */
.scene .scrub-bar{position:absolute;left:0;right:0;bottom:0;height:2px;background:rgba(255,255,255,.08);pointer-events:none}
.scene .scrub-bar i{display:block;height:100%;width:100%;background:var(--brand, #ffb74d);transform-origin:0 50%;transform:scaleX(0)}
.scene.static .scrub-bar{display:none}
.scene-cap{max-width:1600px;margin:12px auto 0;font:400 12px/1.4 var(--font-mono, "Space Mono", ui-monospace, monospace);color:var(--muted-foreground, #a8a29e);letter-spacing:.04em}
@media (max-width:759px){
  .scene{aspect-ratio:auto}
  .scene .topfade{display:block;position:absolute;left:0;right:0;background:linear-gradient(#1b140d,transparent);pointer-events:none}
}
@media (prefers-reduced-motion: reduce){ .scene-track{height:auto} .scene-pin{position:static} }
</style>

<script>
  import { initSunbeamScene } from '../../scripts/motion/scene-scrub.js';
  document.querySelectorAll('#scene').forEach((el) => initSunbeamScene(el));
</script>
