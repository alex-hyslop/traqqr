---
// A bento of four tiles (Figma: /klicktipp-tracking/ §2 5232:187): a mono eyebrow and 36px title on the
// left, then two rows 24px apart, wide + narrow (752 · 424, 320px tall) and narrow + wide (268px). Each
// tile is bg-card, white/10 border, radius 16, 32px padding: mono eyebrow, 24px Light title, one muted
// line, then its own small picture of the data (tags, segments, a follow-up chain, a purchase matched
// to the ad). The pictures are example data. Below lg the tiles stack, text only (Kev's mobile rules).
import { Badge } from '@klicktipp/traqqr-components';
import { ArrowRight, Tag, Users } from 'lucide-react';
import type { Section } from '@/data/sections';

interface Props {
  section: Extract<Section, { kind: 'bento' }>;
}
const { id, eyebrow, title, tiles } = Astro.props.section.props;
const rows = [tiles.slice(0, 2), tiles.slice(2, 4)];
---

<section id={id} aria-labelledby={`${id}-heading`} class="mx-auto flex max-w-312 flex-col gap-10 px-6 py-14 lg:gap-14 lg:py-30">
  <div class="flex flex-col gap-3">
    <p class="font-mono text-xs leading-4 tracking-[0.08em] text-muted-foreground uppercase">{eyebrow}</p>
    <h2 id={`${id}-heading`} class="text-3xl leading-9 font-extralight text-foreground lg:text-4xl lg:leading-10">{title}</h2>
  </div>
  <div class="flex flex-col gap-6">
    {
      rows.map((row, r) => (
        <ul class:list={['grid gap-6', r === 0 ? 'lg:grid-cols-[752fr_424fr]' : 'lg:grid-cols-[424fr_752fr]']}>
          {row.map((tile) => (
            <li class:list={['flex flex-col gap-5 overflow-hidden rounded-2xl border border-white/10 bg-card p-8', r === 0 ? 'lg:h-[320px]' : 'lg:h-[268px]']}>
              <p class="font-mono text-xs leading-4 text-muted-foreground">{tile.eyebrow}</p>
              <h3 class="text-2xl leading-8 font-light text-foreground">{tile.title}</h3>
              <p class="text-sm leading-5 text-muted-foreground">{tile.body}</p>
              <div class="hidden lg:contents" aria-hidden="true">
                {tile.visual.kind === 'tags' && (
                  <div class="flex flex-col gap-2.5 rounded-xl border border-white/6 bg-background p-5 font-mono text-sm leading-5">
                    {tile.visual.items.map((item) => (
                      <p class="flex items-center gap-2">
                        <Tag className="size-3.5 shrink-0 text-muted-foreground" strokeWidth={1.5} />
                        <span class="text-muted-foreground">{item.key}</span>
                        <span class="text-foreground">{item.value}</span>
                      </p>
                    ))}
                  </div>
                )}
                {tile.visual.kind === 'segments' &&
                  tile.visual.items.map((item) => (
                    <p class="flex items-center gap-2 text-sm leading-5">
                      <Users className="size-3.5 shrink-0 text-muted-foreground" strokeWidth={1.5} />
                      <span class="flex-1 text-foreground">{item.name}</span>
                      <span class="font-mono text-muted-foreground">{item.count}</span>
                    </p>
                  ))}
                {tile.visual.kind === 'chain' && (
                  <p class="flex items-center gap-2">
                    {tile.visual.steps.map((step, i) => (
                      <>
                        {i > 0 && <ArrowRight className="size-3.5 text-muted-foreground" strokeWidth={1.5} />}
                        <Badge variant="outline">{step}</Badge>
                      </>
                    ))}
                  </p>
                )}
                {tile.visual.kind === 'purchase' && (
                  <div class="flex items-center gap-4">
                    {[tile.visual.from, tile.visual.to].map((chip, i) => (
                      <>
                        {i > 0 && <span class="h-px w-24 bg-white/20" />}
                        <div class:list={['flex flex-col gap-0.5 rounded-xl border bg-card px-4 py-3 whitespace-nowrap', i > 0 ? 'border-foreground' : 'border-white/10']}>
                          <span class:list={['font-mono text-xs leading-4', i > 0 ? 'text-brand' : 'text-muted-foreground']}>{chip.label}</span>
                          <span class="text-sm leading-5 text-foreground">{chip.value}</span>
                        </div>
                      </>
                    ))}
                    <span class="font-mono text-xs leading-4 text-muted-foreground">{tile.visual.note}</span>
                  </div>
                )}
              </div>
            </li>
          ))}
        </ul>
      ))
    }
  </div>
</section>
