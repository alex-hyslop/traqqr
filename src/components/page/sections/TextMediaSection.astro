---
import { TextMedia } from '@klicktipp/traqqr-components';
import { cn } from '@klicktipp/traqqr-components/utils';
import Reveal from '@/components/Reveal.astro';
import type { Section } from '@/data/sections';

interface Props {
  section: Extract<Section, { kind: 'textMedia' }>;
}
const { section } = Astro.props;
// The library's TextMedia always puts an arrow on its main button. Website buttons have none (Kev, 6 Nov) and
// the shared Button keeps its arrows for the dashboard, so it's hidden here.
---

<Reveal>
  <TextMedia {...section.props} className={cn('[&_a>svg.lucide-arrow-right]:hidden', section.props.className)} />
</Reveal>
