---
import { TextMedia } from '@klicktipp/traqqr-components';
import Reveal from '@/components/Reveal.astro';
import type { Section } from '@/data/sections';

interface Props {
  section: Extract<Section, { kind: 'liveFeed' | 'reverseProxy' }>;
}
const { section } = Astro.props;
---

<Reveal>
  <TextMedia {...section.props} />
</Reveal>
