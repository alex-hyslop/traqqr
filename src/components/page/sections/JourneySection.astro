---
// The journey (Kev's 6 Nov handover: Figma 5400:338 DE, mobile 5401:942): a vertical timeline from
// src/data/about.ts. From lg the rail runs down the centre and the entries alternate photo | dot | text and
// text | dot | photo, the text toward the rail; below lg the rail is on the left. The last step ends on the
// Traqqr mark and the trial button, the only amber here.
//
// Motion (Kev's spec): an entry fades and rises in when it reaches 75% of the viewport, and dims to 25% once
// it has passed the top 20%; scrolling back reverses both. Its dot turns white once reached, and the rail
// draws in with the progress through the section. Only opacity and transform animate, nothing snaps, and the
// listener runs only while the section is on screen. The photo's blur is desktop only: filters cost too much
// on iOS. Without JS or with reduced motion everything is shown, the rail fully drawn.
import { Image } from 'astro:assets';
import { ImageIcon, MapPin } from 'lucide-react';
import { buttonVariants, cn } from '@klicktipp/traqqr-components/utils';
import { TraqqrLogo } from '@/components/brand/TraqqrLogo';
import { journey } from '@/data/about';
import { signupHref } from '@/data/links';
import type { Section } from '@/data/sections';
import { toLocale } from '@/i18n';

interface Props {
  section: Extract<Section, { kind: 'journey' }>;
}
const { eyebrow, title, action } = Astro.props.section.props;
const locale = toLocale(Astro.currentLocale);
const last = journey.length - 1;
const mono = 'font-mono text-xs leading-4 tracking-[0.08em] text-muted-foreground uppercase';
---

<section class="journey mx-auto max-w-312 px-6 pt-14 pb-14 lg:pt-30 lg:pb-24" aria-labelledby="journey-heading" data-journey>
  <div class="flex flex-col gap-2.5 lg:items-center lg:gap-3 lg:text-center">
    <p class={mono}>{eyebrow}</p>
    <h2 id="journey-heading" class="text-[28px] leading-9 font-extralight text-foreground lg:text-4xl lg:leading-[44px]">{title}</h2>
  </div>

  <ol class="relative mt-8 flex flex-col gap-12 pl-8 lg:mt-14 lg:gap-24 lg:py-12 lg:pl-0">
    <span class="journey-rail" aria-hidden="true"><span data-journey-rail></span></span>
    {
      journey.map((step, i) => {
        const flip = i % 2 === 1;
        const date = step.date[locale];
        const place = step.place[locale];
        return (
          <li class="journey-entry relative grid grid-cols-1 lg:grid-cols-[1fr_152px_1fr] lg:items-center" data-journey-entry>
            <figure class:list={['journey-photo relative mt-3.5 aspect-4/3 max-lg:order-2 overflow-hidden rounded-xl border border-white/10 bg-card lg:mt-0', flip ? 'lg:col-start-3' : 'lg:col-start-1', 'lg:row-start-1']}>
              {step.image ? (
                <Image src={step.image} alt={step.alt[locale]} widths={[400, 620, 1000]} sizes="(min-width: 1024px) 500px, calc(100vw - 80px)" class="size-full object-cover" />
              ) : (
                <div class="flex size-full items-center justify-center" role="img" aria-label={step.alt[locale]}>
                  <ImageIcon className="size-7 text-muted-foreground" strokeWidth={1.5} aria-hidden="true" />
                </div>
              )}
              <figcaption class="absolute bottom-3.5 left-4 flex items-center gap-1.5 rounded-lg border border-white/10 bg-background/70 px-2 py-1.5 font-mono text-[10px] leading-3.5 tracking-[0.08em] text-foreground uppercase">
                <MapPin className="size-3" strokeWidth={1.5} aria-hidden="true" />
                {place} · {date}
              </figcaption>
            </figure>

            <span class="journey-node" aria-hidden="true">
              {i === last ? <TraqqrLogo height={32} className="max-w-(--logo-mark)" /> : <span class="journey-dot" />}
            </span>

            <div class:list={['journey-text max-lg:contents lg:row-start-1 lg:flex lg:flex-col', flip ? 'lg:col-start-1 lg:items-end lg:text-right' : 'lg:col-start-3']}>
              <p class="flex items-center gap-3 max-lg:order-1">
                <span class={mono}>{date}</span>
                <span class="font-mono text-xs text-muted-foreground" aria-hidden="true">·</span>
                <span class="flex items-center gap-1.5 text-base leading-6 font-medium text-foreground">
                  <MapPin className="size-4" strokeWidth={1.5} aria-hidden="true" />
                  {place}
                </span>
              </p>
              <div class="flex flex-col max-lg:order-3 lg:mt-4">
                <h3 class="mt-3.5 text-[22px] leading-[30px] font-light text-foreground lg:mt-0 lg:text-[28px] lg:leading-9">{step.title[locale]}</h3>
                <p class="mt-3.5 text-base leading-[26px] text-muted-foreground lg:mt-4">{step.text[locale]}</p>
                {i === last && (
                  <a href={signupHref} class={cn(buttonVariants({ size: 'lg' }), 'mt-6 self-start', flip && 'lg:self-end')}>
                    {action}
                  </a>
                )}
              </div>
            </div>
          </li>
        );
      })
    }
  </ol>
</section>

<style>
  /* The rail: 1px, fading into the dark at both ends; the inner line is what draws in. */
  .journey-rail {
    position: absolute;
    inset-block: 0;
    left: 7px;
    width: 1px;
    mask: linear-gradient(transparent, #000 12%, #000 60%, transparent);
  }
  .journey-rail > span {
    position: absolute;
    inset: 0;
    background: rgb(255 255 255 / 0.35);
    transform-origin: top;
    transform: scaleY(var(--journey-progress, 1));
  }
  @media (min-width: 64rem) {
    .journey-rail {
      left: 50%;
    }
  }

  /* Mobile: the node sits on the left rail, level with the date; from lg it's the middle column. */
  .journey-node {
    position: absolute;
    top: 6px;
    left: -32px;
    display: flex;
    width: 15px;
    justify-content: center;
  }
  .journey-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--muted-foreground);
    box-shadow: 0 0 0 4px var(--background);
    transition: background-color 400ms ease;
  }
  .journey-node :global([data-logo]) {
    margin-top: -6px;
    transform: scale(0.75);
  }
  @media (min-width: 64rem) {
    .journey-node {
      position: static;
      grid-column: 2;
      grid-row: 1;
      width: auto;
    }
    .journey-dot {
      width: 14px;
      height: 14px;
    }
    .journey-node :global([data-logo]) {
      margin-top: 0;
      transform: none;
    }
  }

  /* Motion, once the script has started (so without JS everything shows). */
  [data-motion] .journey-entry {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  [data-motion] .journey-entry[data-state='in'] {
    opacity: 1;
    transform: none;
  }
  [data-motion] .journey-entry[data-state='past'] {
    opacity: 0.25;
    transform: none;
  }
  [data-motion] .journey-entry:not([data-state='before']) .journey-dot {
    background: var(--foreground);
  }
  @media (min-width: 64rem) and (hover: hover) {
    [data-motion] .journey-photo {
      transition:
        transform 700ms cubic-bezier(0.2, 0.7, 0.2, 1),
        filter 700ms cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    [data-motion] .journey-entry[data-state='before'] .journey-photo {
      transform: scale(1.03);
      filter: blur(6px);
    }
  }
  /* Without motion the dots are white (all reached) and the rail is drawn. */
  .journey:not([data-motion]) .journey-dot {
    background: var(--foreground);
  }
</style>

<script>
  const IN_LINE = 0.75;
  const PAST_LINE = 0.2;

  for (const section of document.querySelectorAll<HTMLElement>('[data-journey]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    const entries = [...section.querySelectorAll<HTMLElement>('[data-journey-entry]')];
    const rail = section.querySelector<HTMLElement>('[data-journey-rail]')!;
    const list = rail.closest('ol')!;
    let frame = 0;

    const update = () => {
      frame = 0;
      const vh = window.innerHeight;
      for (const entry of entries) {
        const box = entry.getBoundingClientRect();
        const state = box.top + box.height / 2 < vh * PAST_LINE ? 'past' : box.top < vh * IN_LINE ? 'in' : 'before';
        if (entry.dataset.state !== state) entry.dataset.state = state;
      }
      const box = list.getBoundingClientRect();
      const progress = Math.min(1, Math.max(0, (vh * IN_LINE - box.top) / box.height));
      rail.style.setProperty('--journey-progress', progress.toFixed(4));
    };
    const onScroll = () => {
      if (!frame) frame = requestAnimationFrame(update);
    };

    update();
    section.dataset.motion = '';
    // Listen only while the section is on screen.
    new IntersectionObserver(([observed]) => {
      if (observed.isIntersecting) {
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        update();
      } else {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      }
    }).observe(section);
  }
</script>
