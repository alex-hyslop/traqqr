---
import { Cta } from '@klicktipp/traqqr-components';
import Reveal from '@/components/Reveal.astro';
import type { Section } from '@/data/sections';

interface Props {
  section: Extract<Section, { kind: 'cta' }>;
}
const { section } = Astro.props;
// Which of Kev's CTA card animations (cta-bg.js) this page gets: the page data's `background`, else "lock".
const background = section.background ?? 'lock';
---

<Reveal>
  <div data-cta={background}>
    <Cta {...section.props} />
  </div>
</Reveal>

<style>
  /* Kev, 5 Nov: no app-background layer on the CTA card (the library's bg-cta-glow); the card is var(--card)
     with an amber wash from the top, on every CTA. Until the library takes this, the site overrides it here. */
  :global(.rounded-xl:has(> div > .bg-cta-glow)) {
    background: linear-gradient(180deg, rgb(255 183 77 / 0.19) -3%, rgb(255 183 77 / 0) 80%), var(--card);
  }
  :global(.bg-cta-glow) {
    display: none;
  }
  /* Kev's CTA backgrounds (cta-bg.js) draw on a canvas at z-index -1 inside the card. */
  :global([data-cta-bg]) {
    isolation: isolate;
  }
</style>

<script>
  // Kev's CTA card backgrounds (5 Nov, cta-bg.js as he sent it): "lock", brackets locking around the amber
  // button, or "dots", a dot field with a ring closing in on it. The library's Cta can't take data
  // attributes, so the card, its main button and its copy are marked here, the effect from the wrapper.
  // Desktop pointers only: below 1024px or on touch nothing is mounted, so no canvas exists there (the
  // script would only hide its canvas, and iOS is short of graphics memory, see global.css). Once per page.
  import { mountAllCtaBackgrounds } from '@/scripts/motion/cta-bg.js';

  const desktop = matchMedia('(min-width: 1024px) and (pointer: fine)');
  let mounted = false;
  const mount = () => {
    if (mounted || !desktop.matches) return;
    mounted = true;
    document.querySelectorAll<HTMLElement>('[data-cta]').forEach((wrap) => {
      const card = wrap.querySelector<HTMLElement>('.rounded-xl:has(> div > .bg-cta-glow)');
      const primary = card?.querySelector<HTMLElement>('[data-slot="cta-buttons"] > a:first-child');
      if (!card || !primary) return;
      card.dataset.ctaBg = wrap.dataset.cta || 'lock';
      primary.dataset.ctaBgTarget = '';
      const copy = card.querySelector<HTMLElement>(':scope > div.relative > div:first-child');
      if (copy) copy.dataset.ctaBgCopy = '';
    });
    mountAllCtaBackgrounds();
  };
  mount();
  desktop.addEventListener('change', mount);
</script>
