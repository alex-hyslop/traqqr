---
// The internal-page hero (Kev's 3 Nov handover §3.2, §3.4; Figma e.g. /live-feed/ 5225:3): the dashboard
// Breadcrumb, a 60/72 ExtraLight title, an 18px lead and the CTA pair, over the grid with the half-radial
// top glow layered above it (so the grid's fade never shows as a dark box). "split" puts the motion
// piece on the right of the 560px copy, both centred on one line (Figma: y≈428); "centred" puts
// the copy in the middle (900px, 20px apart) and the piece under it. Without a secondary action there are
// no buttons (Event Inspector). The Lösungen pages use the explainer video in place of a piece (split) or a
// row of four glass cards under a centred hero, as on the homepage. Below md the hero is copy and buttons
// only (§6.5).
import {
  Breadcrumb,
  BreadcrumbItem,
  BreadcrumbLink,
  BreadcrumbList,
  BreadcrumbPage,
  BreadcrumbSeparator,
  CtaButtons,
  DesktopLines,
  LandingCard,
  VideoPlaceholder,
} from '@klicktipp/traqqr-components';
import { cn } from '@klicktipp/traqqr-components/utils';
import MotionPiece from '@/components/motion/MotionPiece.astro';
import { motionPieces } from '@/components/motion/pieces';
import type { Section } from '@/data/sections';
import { siteContent } from '@/data/site';
import { toLocale } from '@/i18n';

interface Props {
  section: Extract<Section, { kind: 'pageHero' }>;
}
const { layout, breadcrumb, title, lead, secondaryAction, motion, video, cards, motionGap = 8 } = Astro.props.section.props;
const { trial } = siteContent[toLocale(Astro.currentLocale)].cta;
const centred = layout === 'centred';
// Split heroes centre the visual on y≈428, as every Figma frame does, whatever the piece's height. With the
// video the copy is the taller side, so it sits at Figma's y 196 instead.
const visualHeight = motion ? ((motion.width ?? 620) * motionPieces[motion.id].size[1]) / motionPieces[motion.id].size[0] : 455;
const splitTop = video ? '196px' : `${Math.round(428 - visualHeight / 2)}px`;
const splitBottom = video ? '96px' : '105px';
---

<section class="relative isolate overflow-hidden">
  <div class="grid-bg absolute inset-x-0 top-30 bottom-0 -z-10" aria-hidden="true"></div>
  <div class="hero-glow pointer-events-none absolute inset-0 -z-10" aria-hidden="true"></div>

  <div
    class:list={[
      'mx-auto flex flex-col gap-10 px-6 pt-24 pb-16',
      // The video hero sits on the 1152px content column (Figma: copy at x 144, video ending at 1296).
      video ? 'max-w-300' : 'max-w-312',
      centred
        ? ['items-center text-center lg:gap-(--motion-gap)', cards ? 'lg:pt-[170px] lg:pb-24' : 'lg:pt-[176px] lg:pb-12']
        : 'lg:flex-row lg:items-center lg:gap-5 lg:pt-(--split-top) lg:pb-(--split-bottom)',
    ]}
    style={centred ? `--motion-gap: ${motionGap}px` : `--split-top: ${splitTop}; --split-bottom: ${splitBottom}`}
  >
    <div class:list={['flex flex-col', centred ? 'max-w-225 items-center gap-5' : 'gap-6 lg:w-[560px] lg:shrink-0']}>
      <Breadcrumb>
        <BreadcrumbList>
          <BreadcrumbItem>
            <BreadcrumbLink href={breadcrumb.parent.href}>{breadcrumb.parent.label}</BreadcrumbLink>
          </BreadcrumbItem>
          <BreadcrumbSeparator />
          <BreadcrumbItem>
            <BreadcrumbPage>{breadcrumb.current}</BreadcrumbPage>
          </BreadcrumbItem>
        </BreadcrumbList>
      </Breadcrumb>
      <h1 class="text-4xl leading-10 font-extralight text-foreground lg:text-6xl lg:leading-[72px]">
        <DesktopLines lines={title} />
      </h1>
      <p class:list={['text-base leading-6 text-muted-foreground lg:text-lg lg:leading-7', centred ? 'max-w-[640px]' : 'lg:max-w-[520px]']}>
        {lead}
      </p>
      {secondaryAction && <CtaButtons primary={trial} arrow secondary={secondaryAction} stackOnMobile className={cn(centred && 'justify-center')} />}
    </div>
    {
      motion && (
        <div class:list={['w-full', !centred && 'lg:min-w-0 lg:flex-1']}>
          <div class="mx-auto w-full" style={motion.width ? `max-width: ${motion.width}px` : undefined}>
            <MotionPiece id={motion.id} label={motion.label} />
          </div>
        </div>
      )
    }
    {
      video && (
        <div class="hidden w-full md:block lg:ml-auto lg:max-w-[560px] lg:min-w-0 lg:flex-1">
          <VideoPlaceholder label={video.label} href={video.href} />
        </div>
      )
    }
  </div>
  {
    cards && (
      <ul class="relative mx-auto grid max-w-[1440px] grid-cols-1 gap-3 px-3 md:grid-cols-2 lg:grid-cols-4 lg:gap-4 lg:px-6">
        {cards.map((card) => (
          <LandingCard {...card} fill="glass" titleAs="h2" />
        ))}
      </ul>
    )
  }
</section>
