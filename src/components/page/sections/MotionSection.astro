---
// A motion piece in its own section, optionally under a centred heading: a mono eyebrow and a 36px
// ExtraLight title (Figma e.g. /live-feed/ §3 5225:165: 120px padding, 56px from heading to piece).
// `width` is the piece's width in the Figma frame; it scales down with the column. A bare piece (no
// heading, e.g. the Live Feed marquee) gets just enough padding to centre it in its band. `align: "left"`
// puts the heading at the column's left edge (Figma /fingerprint-tracking/ §2); `band` puts the section on
// a bg-card band, and `titleSize: "lg"` makes the title 48/60, 64px above the piece (/klicktipp-tracking/ §3).
// Below md, where only the marquee mounts, `fallback` shows the piece's content as static HTML: the small
// vertical rail, or the two Browser / Server panels.
import { Badge } from '@klicktipp/traqqr-components';
import { Check, Globe, Server } from 'lucide-react';
import MotionPiece from '@/components/motion/MotionPiece.astro';
import MobileRail from '@/components/page/MobileRail.astro';
import type { Section } from '@/data/sections';

interface Props {
  section: Extract<Section, { kind: 'motion' }>;
}
const { id, eyebrow, title, align = 'center', titleSize = 'md', band = false, motion, fallback } = Astro.props.section.props;
const left = align === 'left';
const headingId = title ? `${id}-heading` : undefined;
---

<section id={id} aria-labelledby={headingId} class:list={[band && 'border-y border-white/10 bg-card']}>
  <div
    class:list={[
      'mx-auto flex max-w-312 flex-col items-center px-6',
      title ? ['gap-10 py-14 lg:py-30', titleSize === 'lg' ? 'lg:gap-16' : 'lg:gap-14'] : 'py-[15px]',
    ]}
  >
    {
      title && (
        <div class:list={['flex flex-col gap-3', left ? 'self-start' : 'items-center text-center']}>
          {eyebrow && <p class="font-mono text-xs leading-4 tracking-[0.08em] text-muted-foreground uppercase">{eyebrow}</p>}
          <h2
            id={headingId}
            class:list={['text-3xl leading-9 font-extralight text-foreground', titleSize === 'lg' ? 'lg:text-5xl lg:leading-15' : 'lg:text-4xl lg:leading-10']}
          >
            {title}
          </h2>
        </div>
      )
    }
    <div class="w-full" style={`max-width: ${motion.width}px`}>
      <MotionPiece id={motion.id} label={motion.label} />
    </div>
    {
      fallback?.kind === 'rail' && (
        <div class="flex w-full flex-col gap-6 md:hidden">
          <MobileRail items={fallback.items} />
          {fallback.note && <p class="font-mono text-xs leading-4 text-muted-foreground">{fallback.note}</p>}
        </div>
      )
    }
    {
      fallback?.kind === 'panels' && (
        <div class="flex w-full flex-col items-center gap-4 md:hidden">
          {fallback.panels.map((panel, i) => (
            <>
              {i > 0 && (
                <div class="flex flex-col items-center gap-2">
                  <Badge className="bg-success/15 text-success">{fallback.link.badge}</Badge>
                  <span class="font-mono text-xs leading-4 text-muted-foreground">{fallback.link.note}</span>
                </div>
              )}
              <div class="flex w-full flex-col gap-4 rounded-2xl border border-white/10 bg-card p-6">
                <p class="flex items-center gap-3 text-2xl leading-8 font-light text-foreground">
                  {panel.icon === 'globe' ? (
                    <Globe className="size-6" strokeWidth={1.25} aria-hidden="true" />
                  ) : (
                    <Server className="size-6" strokeWidth={1.25} aria-hidden="true" />
                  )}
                  {panel.title}
                </p>
                <Badge variant="secondary" className="self-start">
                  {panel.badge}
                </Badge>
                <ul class="flex flex-col gap-3 text-sm leading-5 text-foreground">
                  {panel.items.map((item) => (
                    <li class="flex items-center gap-2.5">
                      <Check className="size-4 shrink-0 text-muted-foreground" strokeWidth={1.5} aria-hidden="true" />
                      {item}
                    </li>
                  ))}
                </ul>
              </div>
            </>
          ))}
        </div>
      )
    }
  </div>
</section>
