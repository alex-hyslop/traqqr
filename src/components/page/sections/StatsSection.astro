---
import Reveal from '@/components/Reveal.astro';
import { Stats } from '@/components/sections/Stats';
import type { Section } from '@/data/sections';

interface Props {
  section: Extract<Section, { kind: 'stats' }>;
}
const { section } = Astro.props;
---

<Reveal>
  <Stats {...section.props} />
</Reveal>
