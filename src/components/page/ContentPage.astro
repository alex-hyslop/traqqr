---
// An internal page in either language, rendered by src/pages/[slug].astro (DE) and src/pages/en/[slug].astro (EN).
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageSections from '@/components/page/PageSections.astro';
import type { ContentPage } from '@/data/pages/content';
import { pathFor, toLocale, type RouteKey } from '@/i18n';

interface Props {
  route: RouteKey;
  page: ContentPage;
}
const { route, page } = Astro.props;
const locale = toLocale(Astro.currentLocale);

// FAQPage structured data from the same items the page's FAQ shows, as on the homepage (HomePage.astro).
const faqItems = page.sections.flatMap((section) => (section.kind === 'faq' ? section.props.items : []));
const structuredData = faqItems.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      inLanguage: locale,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    }
  : null;

// BreadcrumbList from the hero's breadcrumb: Traqqr, then this page. The menu crumb ("Produkt") has no
// page, so it's left out here; Google wants a URL on every item but the last.
const hero = page.sections.find((section) => section.kind === 'pageHero');
const breadcrumbData = hero && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Traqqr', item: new URL(pathFor('home', locale), Astro.site).href },
    { '@type': 'ListItem', position: 2, name: hero.props.breadcrumb.current, item: new URL(pathFor(route, locale), Astro.site).href },
  ],
};
const jsonLd = (data: object) => JSON.stringify(data).replace(/</g, '\\u003c');
---

<BaseLayout route={route} title={page.title} description={page.description}>
  {structuredData && <script slot="head" type="application/ld+json" set:html={jsonLd(structuredData)} />}
  {breadcrumbData && <script slot="head" type="application/ld+json" set:html={jsonLd(breadcrumbData)} />}
  <PageSections sections={page.sections} />
</BaseLayout>
