---
// A topic page's article list (Kev, 6 Nov: Figma 5368:10), generated from the collection so it can't go stale:
// the topic's articles in sidebar order, grouped under their `section` label, as clickable cards (the
// Integration Card behaviour: muted chevron, the card lightens and the chevron turns white on hover).
// Then "Nicht dabei?" with the support button.
import { helpTopics, helpPath } from '@/data/help';
import { getEntry } from 'astro:content';
import { helpCopy, helpLocale, supportHref } from './copy';

const route = Astro.locals.starlightRoute;
const locale = helpLocale(route.locale);
const copy = helpCopy[locale];
const topicSlug = route.id.replace(/^(de\/)?help\//, '').replace(/\/$/, '').split('/')[0];
const topic = helpTopics.find((t) => t.slug === topicSlug);
const prefix = locale === 'de' ? 'de/' : '';

const articles = topic
  ? (await Promise.all(topic.articles.map((slug) => getEntry('docs', `${prefix}help/${topic.slug}/${slug}`)))).flatMap((entry, i) =>
      entry ? [{ href: helpPath(`${topic.slug}/${topic.articles[i]}`, locale), title: entry.data.title, description: entry.data.description, section: entry.data.section ?? copy.otherArticles }] : [],
    )
  : [];
const sections = [...new Set(articles.map((a) => a.section))];
---

<div class="not-content tq-topic-articles">
  {
    sections.map((section) => (
      <section>
        <h2 class="tq-section-label">{section}</h2>
        <div class="tq-card-grid">
          {articles
            .filter((a) => a.section === section)
            .map((a) => (
              <a href={a.href} class="tq-card-link tq-article-card">
                <span class="tq-article-title">
                  <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                    <path d="M14 2v4a2 2 0 0 0 2 2h4M10 9H8m8 4H8m8 4H8" />
                  </svg>
                  {a.title}
                  <svg class="tq-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
                    <path d="m9 18 6-6-6-6" />
                  </svg>
                </span>
                {a.description && <span class="tq-article-description">{a.description}</span>}
              </a>
            ))}
        </div>
      </section>
    ))
  }
  <div class="tq-missing">
    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"
      ><circle cx="12" cy="12" r="10"></circle><path d="m4.93 4.93 4.24 4.24M14.83 9.17l4.24-4.24M14.83 14.83l4.24 4.24M9.17 14.83l-4.24 4.24"></path><circle cx="12" cy="12" r="4"></circle></svg
    >
    <div>
      <p class="tq-missing-title">{copy.missing}</p>
      <p class="tq-missing-lead">{copy.missingLead}</p>
    </div>
    <a href={supportHref(locale)} class="tq-button">{copy.contact}</a>
  </div>
</div>
