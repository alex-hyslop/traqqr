---
// Language suggestion (Figma: Language suggestion 5300:731, preview 5301:27274; Kev's 5 Nov update to the
// language switcher spec). A glass card in the bottom corner offering this page in the other language,
// written in that language. It never redirects: it shows only when none of the browser's languages
// matches the page, and only until the person chooses (Switch, ✕, or a pick in the nav switcher). The
// choice is saved in localStorage as "tq-lang", nothing before it, so no consent banner is needed.
// A saved choice also opens the homepage in that language on later visits; inner pages stay as linked.
import { buttonVariants, cn } from '@klicktipp/traqqr-components/utils';
import { Globe, X } from 'lucide-react';
import { locales, type Locale } from '@/i18n';

interface Props {
  locale: Locale;
  /** This page's path in each language. */
  paths: Record<Locale, string>;
}

const { locale, paths } = Astro.props;
const offer = locales.find((l) => l !== locale)!;

// Always in the language it offers.
const copy: Record<Locale, { region: string; message: string; action: string; dismiss: string }> = {
  en: {
    region: 'Language suggestion',
    message: 'This page is also available in English.',
    action: 'Switch to English',
    dismiss: 'Dismiss',
  },
  de: {
    region: 'Sprachvorschlag',
    message: 'Diese Seite gibt es auch auf Deutsch.',
    action: 'Auf Deutsch wechseln',
    dismiss: 'Schließen',
  },
};
const t = copy[offer];
---

<div
  role="region"
  aria-label={t.region}
  lang={offer}
  class="lang-suggest fixed inset-x-3 z-40 flex flex-col gap-2 rounded-[12px] border bg-popover/88 py-2.5 pr-2.5 pl-4 text-popover-foreground shadow-[inset_0_1px_0_rgb(255_255_255/0.06),0_12px_32px_-8px_rgb(0_0_0/0.4)] backdrop-blur-xl md:inset-x-auto md:right-6 md:bottom-6 md:w-[340px]"
  data-lang-suggest
  data-page-lang={locale}
  data-offer={offer}
  hidden
>
  <div class="flex items-center gap-2.5">
    <Globe className="size-4 shrink-0 text-muted-foreground" strokeWidth={1.5} aria-hidden="true" />
    <p class="flex-1 text-sm leading-5">{t.message}</p>
    <button
      type="button"
      class={cn(buttonVariants({ variant: 'ghost', size: 'icon' }), 'size-7 cursor-pointer rounded-md')}
      aria-label={t.dismiss}
      data-lang-dismiss
    >
      <X className="size-4" strokeWidth={1.5} aria-hidden="true" />
    </button>
  </div>
  <a href={paths[offer]} hreflang={offer} class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'ml-[26px] self-start')} data-lang-pick>
    {t.action}
  </a>
</div>

<style>
  /* Mobile: 12px above the bottom edge plus the home indicator. */
  .lang-suggest {
    bottom: calc(0.75rem + env(safe-area-inset-bottom));
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 240ms cubic-bezier(0.2, 0.7, 0.2, 1),
      transform 240ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  @media (min-width: 48rem) {
    .lang-suggest {
      bottom: 1.5rem;
    }
  }
  .lang-suggest[data-state='in'] {
    opacity: 1;
    transform: none;
  }
  .lang-suggest[data-state='out'] {
    opacity: 0;
    transition-duration: 160ms;
    transition-timing-function: cubic-bezier(0.4, 0, 0.7, 0.2);
  }
  @media (prefers-reduced-motion: reduce) {
    .lang-suggest {
      transform: none;
    }
  }
</style>

<script>
  import { initLanguageSuggestion } from '@/scripts/language';
  initLanguageSuggestion();
</script>
