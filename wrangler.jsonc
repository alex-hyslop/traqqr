// The site on Cloudflare Workers (staging.traqqr.ai first). See docs/cloudflare-workers.md.
// The name and account are fixed: deploys must never land on the other Workers in the KlickTipp account
// (traqqr-website, traqqr, and an existing traqqr-site of unknown origin; Alex, 6 Nov).
{
  "name": "traqqr-site-staging",
  "account_id": "775cebacef9a5e08e731d69df239ae38", // Digital Results International / KlickTipp
  "main": "./worker/index.js",
  "compatibility_date": "2026-10-01",
  // `wrangler deploy` and `wrangler dev` build first: the Astro site, then dist/_headers and dist/_redirects
  // from vercel.json. The build needs GITHUB_TOKEN (read:packages) for @klicktipp/traqqr-components.
  "build": { "command": "node_modules/.bin/astro build && node scripts/cf-assets.mjs" },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Unknown URLs get the nearest 404.html with status 404: dist/de/404.html under /de/, else dist/404.html.
    "not_found_handling": "404-page",
    // The Worker adds noindex and the staging sign-up link (worker/index.js); the videos skip it.
    "run_worker_first": ["/*", "!/media/*"]
  },
  "workers_dev": true,
  "preview_urls": false
}
